# ---------------------------------------------------------------------------
# Docker (docker compose) — everything here is optional; defaults shown.
# DATABASE_URL / DATABASE_SSL are set automatically inside compose, and an
# auth secret is generated on first start if BETTER_AUTH_SECRET is empty.
# ---------------------------------------------------------------------------
# POSTGRES_USER=thodz
# POSTGRES_PASSWORD=thodz
# POSTGRES_DB=thodz
# APP_PORT=3000

# ---------------------------------------------------------------------------
# Database — only needed when running WITHOUT Docker (npm run dev)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://thodz:thodz@localhost:5432/thodz"
# disable     → local / Docker Postgres (no TLS)
# require     → hosted DB with TLS, certificate not verified (default)
# verify-full → hosted DB with TLS, certificate verified
DATABASE_SSL=disable

# ---------------------------------------------------------------------------
# Auth (Better Auth)
# ---------------------------------------------------------------------------
# Required in production (32+ chars): openssl rand -base64 32
BETTER_AUTH_SECRET=""
# Public URL users open in the browser. Sign-in requests from any other
# origin are rejected, so change it if you serve on another host/port.
BETTER_AUTH_URL="http://localhost:3000"

# Optional social login: each provider is enabled only when both values are set.
# OAuth callback URL to register: <BETTER_AUTH_URL>/api/auth/callback/<google|github>
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Uploads — stored on local disk (in Docker: the app-data volume)
# ---------------------------------------------------------------------------
# UPLOAD_DIR=./data/uploads
