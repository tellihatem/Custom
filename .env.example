# ---------------------------------------------------------------------------
# Docker (docker compose) — these are all optional; defaults shown.
# DATABASE_URL / DATABASE_SSL are set automatically inside compose.
# ---------------------------------------------------------------------------
# POSTGRES_USER=thodz
# POSTGRES_PASSWORD=thodz
# POSTGRES_DB=thodz
# APP_PORT=3000

# ---------------------------------------------------------------------------
# Database — only needed when running WITHOUT Docker (npm run dev)
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://thodz:thodz@localhost:5432/thodz"
# disable     → local / Docker Postgres (no TLS)
# require     → hosted DB with TLS, certificate not verified (default)
# verify-full → hosted DB with TLS, certificate verified
DATABASE_SSL=disable

# ---------------------------------------------------------------------------
# Supabase Auth — required for login until Phase 2 replaces it.
# These are baked into the image at build time: rebuild after changing them.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
